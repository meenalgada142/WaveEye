# ── Cython build artefacts ────────────────────────────────────────────────
# Compiled extensions (Windows .pyd, Linux/macOS .so)
*.pyd
*.so

# Cython-generated C files (safe to delete; regenerated by build)
**/*.c

# Cython HTML annotation files
**/*.html

# setuptools/distutils build tree
build/
dist/

# Egg / wheel metadata
*.egg-info/
*.egg

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── PyInstaller standalone ────────────────────────────────────────────────
standalone/

# ── Build logs ────────────────────────────────────────────────────────────
build_log.txt

# ── Closed-source core engine (compiled .pyd/.so distributed separately) ─
IR_backtracking/rca_8.py
IR_backtracking/rca_resolver.py
IR_backtracking/rca_core/

# ── Archive / legacy code ─────────────────────────────────────────────────
_archive_main_tool/

# ── Runtime outputs (not source) ──────────────────────────────────────────
*.proof.json
*.appendix.txt
causal_binding.json

# ── WaveEye user output directories ──────────────────────────────────────
outputs/

# ── IDE / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
